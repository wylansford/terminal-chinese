{
  "vocabulary": [
    {
      "simplified": "为了",
      "traditional": "為了",
      "pinyin": "wèile",
      "english": "in order to; for the sake of",
      "hsk_level": 3,
      "word_type": "preposition",
      "emoji": "🎯",
      "mnemonic": "For (为) + completed (了) - FOR THE PURPOSE OF",
      "etymology": "为 (for/do) + 了 (completed)",
      "examples": [
        {
          "chinese": "为了学好中文，我每天练习。",
          "pinyin": "Wèile xué hǎo Zhōngwén, wǒ měitiān liànxí.",
          "english": "In order to learn Chinese well, I practice every day."
        },
        {
          "chinese": "为了健康，要多运动。",
          "pinyin": "Wèile jiànkāng, yào duō yùndòng.",
          "english": "For the sake of health, exercise more."
        }
      ],
      "related_words": ["为", "因为", "所以"],
      "usage_notes": "Indicates purpose or goal"
    },
    {
      "simplified": "虽然",
      "traditional": "雖然",
      "pinyin": "suīrán",
      "english": "although; even though",
      "hsk_level": 3,
      "word_type": "conjunction",
      "emoji": "🤔",
      "mnemonic": "Although (虽) + like that (然) - ALTHOUGH/EVEN THOUGH",
      "etymology": "虽 (although) + 然 (so/like that)",
      "examples": [
        {
          "chinese": "虽然很难，但是我会努力。",
          "pinyin": "Suīrán hěn nán, dànshì wǒ huì nǔlì.",
          "english": "Although it's difficult, I will try hard."
        },
        {
          "chinese": "虽然下雨，我还是去了。",
          "pinyin": "Suīrán xià yǔ, wǒ háishì qù le.",
          "english": "Even though it rained, I still went."
        }
      ],
      "related_words": ["尽管", "即使", "但是"],
      "usage_notes": "Usually paired with 但是 (but)"
    },
    {
      "simplified": "但是",
      "traditional": "但是",
      "pinyin": "dànshì",
      "english": "but; however",
      "hsk_level": 3,
      "word_type": "conjunction",
      "emoji": "↔️",
      "mnemonic": "But (但) + be (是) - BUT/HOWEVER",
      "etymology": "但 (but/only) + 是 (is)",
      "examples": [
        {
          "chinese": "我想去，但是没时间。",
          "pinyin": "Wǒ xiǎng qù, dànshì méi shíjiān.",
          "english": "I want to go, but I don't have time."
        },
        {
          "chinese": "很贵，但是很好。",
          "pinyin": "Hěn guì, dànshì hěn hǎo.",
          "english": "It's expensive, but it's good."
        }
      ],
      "related_words": ["可是", "不过", "然而"],
      "usage_notes": "Introduces contrasting statement"
    },
    {
      "simplified": "如果",
      "traditional": "如果",
      "pinyin": "rúguǒ",
      "english": "if; in case",
      "hsk_level": 3,
      "word_type": "conjunction",
      "emoji": "❓",
      "mnemonic": "As if (如) + result (果) - IF something results",
      "etymology": "如 (like/if) + 果 (result)",
      "examples": [
        {
          "chinese": "如果下雨，我就不去了。",
          "pinyin": "Rúguǒ xià yǔ, wǒ jiù bù qù le.",
          "english": "If it rains, I won't go."
        },
        {
          "chinese": "如果你有时间，来找我。",
          "pinyin": "Rúguǒ nǐ yǒu shíjiān, lái zhǎo wǒ.",
          "english": "If you have time, come find me."
        }
      ],
      "related_words": ["假如", "要是", "倘若"],
      "usage_notes": "Often paired with 就 in result clause"
    },
    {
      "simplified": "因为",
      "traditional": "因為",
      "pinyin": "yīnwèi",
      "english": "because",
      "hsk_level": 3,
      "word_type": "conjunction",
      "emoji": "💡",
      "mnemonic": "Cause (因) + for (为) - BECAUSE (the cause)",
      "etymology": "因 (cause/reason) + 为 (for/because of)",
      "examples": [
        {
          "chinese": "因为下雨，我没去。",
          "pinyin": "Yīnwèi xià yǔ, wǒ méi qù.",
          "english": "Because it rained, I didn't go."
        },
        {
          "chinese": "因为太累了，所以早点睡。",
          "pinyin": "Yīnwèi tài lèi le, suǒyǐ zǎo diǎn shuì.",
          "english": "Because I'm too tired, I'll sleep early."
        }
      ],
      "related_words": ["由于", "所以", "原因"],
      "usage_notes": "Often paired with 所以 (therefore)"
    },
