      "hsk_level": 3,
      "word_type": "conjunction",
      "emoji": "➡️",
      "mnemonic": "That which (所) + using (以) - THEREFORE/SO",
      "etymology": "所 (that which) + 以 (with/by means of)",
      "examples": [
        {
          "chinese": "太贵了，所以我没买。",
          "pinyin": "Tài guì le, suǒyǐ wǒ méi mǎi.",
          "english": "It was too expensive, so I didn't buy it."
        },
        {
          "chinese": "因为生病，所以没来。",
          "pinyin": "Yīnwèi shēngbìng, suǒyǐ méi lái.",
          "english": "Because of illness, (I) didn't come."
        }
      ],
      "related_words": ["因此", "因而", "因为"],
      "usage_notes": "Shows result or consequence"
    },
    {
